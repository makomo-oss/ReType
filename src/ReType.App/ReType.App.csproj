<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ReType.Core\ReType.Core.csproj" />
    <ProjectReference Include="..\ReType.Converters\ReType.Converters.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ReType</AssemblyName>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>ReType</Product>
    <Description>ファイルの拡張子を変えるだけのシンプルファイル変換</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <!-- Bundle third-party tools (fetched by scripts/fetch-tools.ps1) next to the app. -->
  <ItemGroup>
    <None Include="..\..\thirdparty\bin\**\*"
          Link="thirdparty\bin\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\thirdparty\bin')" />
  </ItemGroup>

</Project>